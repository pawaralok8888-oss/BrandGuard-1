# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Authentication (Production JWT secret)
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars

# CORS (comma-separated frontend origins)
FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# AI Engine (Optional - falls back to deterministic rule engine if unset)
GEMINI_API_KEY=
BRANDGUARD_MODEL=gemini-flash-lite-latest

# Environment
ENV=production
